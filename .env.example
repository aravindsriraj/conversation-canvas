# Speechmatics — realtime transcription
SPEECHMATICS_API_KEY=

# Gemini — orchestrator LLM
GOOGLE_GENERATIVE_AI_API_KEY=

# Browser ↔ server WebSocket. Local: ws://localhost:3000/ws. Production: wss://<host>/ws.
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# HTTP port for the custom Node server.
PORT=3000

# ── Clerk (auth) ──────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys.
# The publishable key is client-safe; the secret key MUST stay server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk redirects after sign in / sign up. Keep these as-is unless you're
# moving the dashboard route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# ── Neon Postgres ─────────────────────────────────────────────
# From https://console.neon.tech → your project → Connection Details → pooled.
# Format: postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://REPLACE_ME
